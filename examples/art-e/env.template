# ART-E Email Agent Training Environment Variables Template
# 复制此文件为 .env 并填写实际值: cp env.template .env
# 注意: .env 文件包含敏感信息，请不要提交到 Git

# ========================================
# AWS 凭证（用于 S3 存储检查点和日志）
# ========================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-west-2

# ========================================
# Weights & Biases（用于训练监控和可视化）
# ========================================
# 获取 API Key: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=art-e-email-agent
WANDB_ENTITY=your_wandb_username_or_team

# ========================================
# OpenAI API（如果使用 OpenAI 模型进行评估）
# ========================================
OPENAI_API_KEY=sk-your_openai_api_key_here

# ========================================
# 训练配置（可选）
# ========================================
# 禁用 unsloth（如果遇到兼容性问题）
IMPORT_UNSLOTH=0

# Python 环境
PYTHONUNBUFFERED=1

# ========================================
# 其他配置（可选）
# ========================================
# HuggingFace Token（如果使用 gated models）
# HF_TOKEN=your_huggingface_token_here

# Slack 通知（可选，训练完成后发送通知）
# SLACK_WEBHOOK_URL=your_slack_webhook_url_here

